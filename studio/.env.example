# Copy this file to .env (in this studio/ folder) and fill in the values.
#
# These are NOT passwords. They are the same public values that go in the
# website's js/config.js (SANITY_PROJECT_ID and SANITY_DATASET) and must match them.
# Find the project id at sanity.io/manage.
#
# Never put an API token here or anywhere in the website.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
